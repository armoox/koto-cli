version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

update_script() {
    info "[branch:$branch] Checking for Update.."
    update="$(curl --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/armoox/koto-cli/$branch/koto-cli")" || die "[branch:$branch] Connection error: $update"
    new_version="$(printf "%s" "$update" | sed -nE 's|^version_number="([^"]+)"$|\1|p')"
    [ -z "$new_version" ] && die "[branch:$branch] Invalid response."
    update="$(printf "%s\n" "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        info "[branch:$branch] Script is up to date :) ($version_number)"
    else
        if printf "%s\n" "$update" | patch "$0" -; then
            info "[branch:$branch] Updated: $version_number -> $new_version"
        else
            die "[branch:$branch] Can't update for some reason!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    for dep; do
        command -v "${dep%% *}" >/dev/null || die "Program \"${dep%% *}\" not found. Please install it."
    done
}

dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d"," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d"," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

where_iina() {
    [ -e "/Applications/IINA.app/Contents/MacOS/iina-cli" ] && echo "/Applications/IINA.app/Contents/MacOS/iina-cli" && return 0
    printf "%s" "iina" && return 0
}

where_mpv() {
    command -v "flatpak" >/dev/null && flatpak info io.mpv.Mpv >/dev/null 2>&1 && printf "%s" "flatpak_mpv" && return 0
    printf "%s" "mpv" && return 0
}

cleanup() {
    tput sgr0               # clears colors
    rm -f "${histfile}.new" # remove temp logfile
    anikoto_feed_cleanup
}

# SCRAPING

select_quality() {
    case "$1" in
        best) result=$(printf "%s" "$links" | head -n1) ;;
        worst) result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n1) ;;
        *) result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$result" ] && warn "Specified quality not found, defaulting to best" && result=$(printf "%s" "$links" | head -n1)

    refr_flag="--referrer=${anikoto_referer:-$provider_base}/"
    episode=$(printf "%s" "$result" | cut -d'>' -f2)

    # non-direct hosts (megaplay etc.) used to ship obfuscated segments that
    # the player can't handle, and the local feed stripped the junk per
    # segment. the CDNs now deliver clean MPEG-TS, so probe the first segment
    # and only use the feed when a real junk prefix is detected
    if [ "$anikoto_direct" != 1 ] && [ -n "$episode" ]; then
        _probe_off="$(probe_anikoto_offset "$episode")"
        if [ -z "$_probe_off" ] || [ "$_probe_off" = "0" ]; then
            anikoto_direct=1
            [ -n "$anikoto_feed_pid" ] && anikoto_feed_cleanup
        else
            if [ -n "$anikoto_feed_pid" ] && [ "$anikoto_feed_variant" != "$episode" ]; then
                anikoto_feed_cleanup
            fi
            if [ -z "$anikoto_feed_pid" ]; then
                start_anikoto_fifo "$episode" "$_probe_off" || { warn "Failed to prepare local feed for stream"; episode=""; return 1; }
            fi
            anikoto_feed_variant="$episode"
            episode="$anikoto_feed_m3u8"
        fi
    fi
}

# anikototv.to: search, get episodes, extract m3u8
provider_base="https://anikototv.to"

anikoto_curl() {
    _retries=3
    _delay=1
    _result=""
    while [ $_retries -gt 0 ]; do
        _result="$($curl_exe -sL -A "$agent" \
            -H 'X-Requested-With: XMLHttpRequest' \
            --max-time 15 "$@" 2>/dev/null | tr -d '\r')"
        if [ -n "$_result" ]; then
            printf '%s' "$_result" | grep -qi "Just a moment" && { _result=""; }
            [ -n "$_result" ] && printf '%s' "$_result" && return 0
        fi
        _retries=$((_retries - 1))
        [ $_retries -gt 0 ] && sleep "$_delay" && _delay=$((_delay * 2))
    done
    return 1
}

# curl wrapper without XHR header — for fetching external embed pages and streams
anikoto_curl_raw() {
    _retries=3
    _delay=1
    _result=""
    while [ $_retries -gt 0 ]; do
        _result="$($curl_exe -sL -A "$agent" \
            --max-time 15 "$@" 2>/dev/null | tr -d '\r')"
        if [ -n "$_result" ]; then
            printf '%s' "$_result" | grep -qi "Just a moment" && { _result=""; }
            [ -n "$_result" ] && printf '%s' "$_result" && return 0
        fi
        _retries=$((_retries - 1))
        [ $_retries -gt 0 ] && sleep "$_delay" && _delay=$((_delay * 2))
    done
    return 1
}

search_anikoto() {
    _query="$(printf '%s' "$1" | sed 's/ /+/g')"
    _page="$(anikoto_curl "${provider_base}/ajax/anime/search?keyword=${_query}")"
    [ -z "$_page" ] && die "Blocked by cloudflare, try again later"
    printf '%s' "$_page" | sed -e 's|\\/|/|g' -e 's|\\"|"|g' -e 's|<a class="item"|\n<a class="item"|g' \
        | sed -nE 's|.*/watch/([a-z0-9-]+)".*name d-title"[^>]*>([^<]+).*|\1\t\2|p' \
        | sed -e "s|&amp;#039;|'|g" -e "s|&#039;|'|g" -e 's|&amp;quot;|"|g' -e 's|&quot;|"|g'
}

# cache the numeric anime id and the episodes JSON per anime to avoid refetching
anikoto_numeric_id=""
anikoto_numeric_slug=""
anime_id_anikoto() {
    _slug="$1"
    if [ "$anikoto_numeric_slug" != "$_slug" ]; then
        _page="$(anikoto_curl "${provider_base}/watch/${_slug}")"
        anikoto_numeric_id="$(printf '%s' "$_page" | tr '\n' ' ' | sed -nE 's|.*id="watch-main"[^>]*data-id="([0-9]+)".*|\1|p')"
        [ -z "$anikoto_numeric_id" ] && anikoto_numeric_id="$(printf '%s' "$_page" | grep -oE 'mangaId = [0-9]+' | head -1 | grep -oE '[0-9]+')"
        anikoto_numeric_slug="$_slug"
    fi
    [ -n "$anikoto_numeric_id" ] || return 1
}

anikoto_ep_clean_id=""
anikoto_ep_clean=""
anime_episodes_json_anikoto() {
    _id="$1"
    if [ "$anikoto_ep_clean_id" != "$_id" ]; then
        anikoto_ep_clean="$(anikoto_curl "${provider_base}/ajax/episode/list/${_id}" | sed -e 's|\\"|"|g' -e 's|\\/|/|g')"
        anikoto_ep_clean_id="$_id"
    fi
}

episodes_list_anikoto() {
    _slug="$1"
    anime_id_anikoto "$_slug" || return 1
    anime_episodes_json_anikoto "$anikoto_numeric_id"
    printf '%s' "$anikoto_ep_clean" \
        | grep -oE 'data-num="[0-9]+"' | grep -oE '[0-9]+' | sort -n -u
}

anikoto_seasons_cached_id=""
anikoto_seasons_cached=""
anikoto_seasons() {
    _id="$1"
    if [ "$anikoto_seasons_cached_id" != "$_id" ]; then
        _raw="$(anikoto_curl "${provider_base}/api/seasons/${_id}")"
        anikoto_seasons_cached=""
        [ -n "$_raw" ] && anikoto_seasons_cached="$(printf '%s' "$_raw" \
            | sed -e 's/\\"/"/g' -e 's|\\/|/|g' \
            | sed 's|</a>|\n</a>|g' \
            | sed -nE 's|.*watch/([a-z0-9-]+)".*<div class="name"[^>]*>([^<]+)<.*|\1	\2|p')"
        anikoto_seasons_cached_id="$_id"
    fi
    printf '%s' "$anikoto_seasons_cached"
}

anikoto_desc() {
    _slug="$1"
    anime_id_anikoto "$_slug" || return 1
    anime_episodes_json_anikoto "$anikoto_numeric_id"
    _first="$(printf '%s' "$anikoto_ep_clean" \
        | sed 's|<a |\n<a |g' | grep 'data-num="1"' | head -1)"
    mal_id="$(printf '%s' "$_first" | grep -oE 'data-mal="[0-9]+"' | head -1 | cut -d'"' -f2)"
    anikoto_seasons "$anikoto_numeric_id" >/dev/null
}

anikoto_m3u8=""
anikoto_referer=""
anikoto_direct=0

# extract server link-ids from a servers JSON; each type is tried in order and
# all matching links are returned (hsub = hard subs, sub, soft-server, dub)
anikoto_server_links() {
    _json="$1"
    _types="$2"
    _all=""
    _flat="$(printf '%s' "$_json" | tr '\n' ' ')"
    for _t in $_types; do
        _found="$(printf '%s' "$_flat" | sed -e 's|\\"|"|g' -e 's|\\/|/|g' \
            | sed 's|<div class="type"|\n<div class="type"|g' \
            | grep "data-type=\"${_t}\"" \
            | grep -oE 'data-link-id="[^"]*"' | cut -d'"' -f2)"
        for _lid in $_found; do
            _all="$_all $_t:$_lid"
        done
    done
    printf '%s' "$_all"
}

get_anikoto_m3u8() {
    _slug="$1"
    _ep_no="$2"
    anikoto_m3u8=""
    anikoto_referer=""
    anikoto_direct=0
    anime_id_anikoto "$_slug" || return 1
    anime_episodes_json_anikoto "$anikoto_numeric_id"
    _anchor="$(printf '%s' "$anikoto_ep_clean" \
        | sed 's|<a |\n<a |g' | grep "data-num=\"${_ep_no}\"" | head -1)"
    [ -z "$_anchor" ] && warn "Episode $_ep_no not found in episode list" && return 1
    _ids="$(printf '%s' "$_anchor" | grep -oE 'data-ids="[^"]*"' | head -1 | cut -d'"' -f2)"
    [ -z "$_ids" ] && warn "Episode $_ep_no has no server data" && return 1
    if [ "$mode" = "dub" ]; then
        _link_types="dub"
    else
        # hard-subbed servers (hsub), fall back to sub then soft-server
        _link_types="hsub sub soft-server"
    fi
    _servers="$(anikoto_curl "${provider_base}/ajax/server/list?servers=${_ids}")"
    _links="$(anikoto_server_links "$_servers" "$_link_types")"
    if [ -z "$_links" ]; then
        # servers may have expired, ask the site to refresh them once
        anikoto_curl "${provider_base}/check-server?manga_id=${anikoto_numeric_id}" >/dev/null 2>&1
        _refresh_wait=0
        while [ "$_refresh_wait" -lt 4 ]; do
            sleep 1
            _refresh_wait=$((_refresh_wait + 1))
            _servers="$(anikoto_curl "${provider_base}/ajax/server/list?servers=${_ids}")"
            _links="$(anikoto_server_links "$_servers" "$_link_types")"
            [ -n "$_links" ] && break
        done
    fi
    [ -z "$_links" ] && warn "No compatible servers found (need hsub/sub/soft-server or dub)" && return 1
    # resolve every server's embed URL up front (parallel) and try direct-playable hosts first
    _direct_urls=""
    _proxied_urls=""
    _resolve_tmp="$(mktemp -d)"
    _resolve_i=0
    for _link in $_links; do
        _lid="${_link#*:}"
        _ltype="${_link%%:*}"
        (anikoto_curl "${provider_base}/ajax/server?get=${_lid}" > "$_resolve_tmp/$_resolve_i" 2>/dev/null
         printf '%s' "$_ltype" > "$_resolve_tmp/$_resolve_i.type") &
        _resolve_i=$((_resolve_i + 1))
    done
    wait
    _resolve_idx=0
    while [ "$_resolve_idx" -lt "$_resolve_i" ]; do
        _embed="$(cat "$_resolve_tmp/$_resolve_idx" 2>/dev/null)"
        _rtype="$(cat "$_resolve_tmp/$_resolve_idx.type" 2>/dev/null)"
        _embed_url="$(printf '%s' "$_embed" | sed -nE 's|.*"url": *"([^"]*)".*|\1|p' | sed 's|\\/|/|g')"
        if [ -n "$_embed_url" ]; then
            case "$_embed_url" in
                *vidtube*|*akirax*) _direct_urls="$_direct_urls $_rtype:$_embed_url" ;;
                *) _proxied_urls="$_proxied_urls $_rtype:$_embed_url" ;;
            esac
        fi
        _resolve_idx=$((_resolve_idx + 1))
    done
    rm -rf "$_resolve_tmp"
    for _entry in $_direct_urls $_proxied_urls; do
        [ -z "$_entry" ] && continue
        _rtype="${_entry%%:*}"
        _embed_url="${_entry#*:}"
        _embed_page="$(anikoto_curl_raw -e "${provider_base}/" "$_embed_url")"
        [ -z "$_embed_page" ] && continue
        # try multiple player patterns — different hosts use different structures
        _file_id="$(printf '%s' "$_embed_page" | tr '\n' ' ' | sed -nE 's|.*id="megaplay-player"[^>]*data-id="([0-9]+)".*|\1|p')"
        [ -z "$_file_id" ] && _file_id="$(printf '%s' "$_embed_page" | tr '\n' ' ' | sed -nE 's|.*id="player"[^>]*data-id="([0-9]+)".*|\1|p')"
        [ -z "$_file_id" ] && _file_id="$(printf '%s' "$_embed_page" | grep -oE 'data-id="[0-9]+"' | head -1 | grep -oE '[0-9]+')"
        [ -z "$_file_id" ] && continue
        _host="$(printf '%s' "$_embed_url" | sed -E 's|^(https?://[^/]+).*|\1|')"
        _src="$(anikoto_curl "${_host}/stream/getSources?id=${_file_id}&type=${_rtype}")"
        [ -z "$_src" ] && continue
        _m3u8="$(printf '%s' "$_src" | sed -nE 's|.*"sources":\{?"file":"([^"]*)".*|\1|p' | sed 's|\\/|/|g')"
        [ -z "$_m3u8" ] && _m3u8="$(printf '%s' "$_src" | sed -nE 's|.*"file":"([^"]*\.m3u8[^"]*)".*|\1|p' | sed 's|\\/|/|g')"
        [ -z "$_m3u8" ] && continue
        anikoto_m3u8="$_m3u8"
        anikoto_referer="$_host"
        case "$_embed_url" in
            *vidtube*|*akirax*) anikoto_direct=1 ;;
            *) anikoto_direct=0 ;;
        esac
        return 0
    done
    return 1
}

# finds where the real MPEG-TS stream starts inside a segment: looks for 4
# sync bytes (0x47) spaced 188 bytes apart and prints the 0-based offset.
# a result of 0 means the segment is already clean MPEG-TS (no junk prefix).
detect_ts_offset() {
    od -An -v -t u1 "$1" 2>/dev/null | tr -s '[:space:]' '\n' | awk '
        NF { b[n++] = $1 }
        END {
            for (o = 0; o + 564 < n; o++) {
                if (b[o] == 71 && b[o + 188] == 71 && b[o + 376] == 71 && b[o + 564] == 71) { print o; exit }
            }
        }'
}

# fetches the first segment of an HLS variant (via a cheap HTTP Range probe)
# and detects its MPEG-TS offset; 0 = clean stream, 252 (or other) = the old
# obfuscated format the local feed was built to strip
probe_anikoto_offset() {
    _variant_url="$1"
    _pl="$(anikoto_curl_raw -e "${anikoto_referer}/" "$_variant_url")"
    printf '%s' "$_pl" | grep -q "EXTM3U" || return 1
    _first_seg="$(printf '%s' "$_pl" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^#' | head -n1)"
    [ -n "$_first_seg" ] || return 1
    case "$_first_seg" in
        http*) ;;
        *) _first_seg="$(printf '%s' "$_variant_url" | sed 's|[^/]*$||')$_first_seg" ;;
    esac
    _probe_file="$(mktemp "${TMPDIR:-/tmp}/anikoto-probe-XXXXXX")"
    _off=""
    curl -sL --max-time 15 -A "$agent" -e "${anikoto_referer}/" -H 'Range: bytes=0-1599' "$_first_seg" > "$_probe_file" 2>/dev/null
    [ -s "$_probe_file" ] && _off="$(detect_ts_offset "$_probe_file")"
    rm -f "$_probe_file"
    [ -n "$_off" ] && printf '%s' "$_off"
}

anikoto_feed_pid=""
anikoto_feed_dir=""
anikoto_feed_m3u8=""
anikoto_feed_variant=""
anikoto_feed_fifo=0

# background feeder: downloads each obfuscated segment, strips the junk prefix
# and writes clean MPEG-TS so the player can read it (pure POSIX shell).
# a sliding window keeps up to 3 downloads active at all times — when one
# finishes the next starts immediately so mpv always has fresh data to read;
# each segment is written via .part + atomic mv so a partial segment is never
# visible, which lets mpv re-open segments for backward seeking
anikoto_feed_stream() {
    _dir="$1"
    _off="$2"
    _max=3
    _i=0
    _urls=""
    while IFS= read -r _u; do
        [ -n "$_u" ] && _urls="$_urls $_u"
    done < "$_dir/segments.txt"
    set -- $_urls
    _pids=""
    _batch=0

    while true; do
        # start new downloads while we have slots and URLs left
        while [ "$_batch" -lt "$_max" ] && [ $# -gt 0 ]; do
            _curl_url="$1"; shift
            (curl -sL --max-time 60 -A "$agent" -e "${anikoto_referer}/" "$_curl_url" \
                | tail -c +$((_off + 1)) > "$_dir/seg${_i}.ts.part") &
            _pids="$_pids $!"
            _batch=$((_batch + 1))
            _i=$((_i + 1))
        done

        # wait for any one download to finish
        _found=0
        for _p in $_pids; do
            kill -0 "$_p" 2>/dev/null && { _found=1; break; }
        done
        [ "$_found" = 0 ] && break
        sleep 0.2

        # clean up completed PIDs
        _new_pids=""
        for _p in $_pids; do
            if kill -0 "$_p" 2>/dev/null; then
                _new_pids="$_new_pids $_p"
            else
                wait "$_p" 2>/dev/null
                _batch=$((_batch - 1))
            fi
        done
        _pids="$_new_pids"

        # move completed .part files when no downloads are active
        if [ -z "$_pids" ]; then
            for _f in "$_dir"/seg*.ts.part; do
                [ -f "$_f" ] || continue
                _seg="${_f%.part}"
                [ -f "$_seg" ] || mv "$_f" "$_seg" 2>/dev/null
            done
        fi
    done

    # move any remaining .part files
    for _f in "$_dir"/seg*.ts.part; do
        [ -f "$_f" ] || continue
        _seg="${_f%.part}"
        [ -f "$_seg" ] || mv "$_f" "$_seg" 2>/dev/null
    done
}

# builds a local m3u8 + segment cache for an obfuscated variant stream and
# starts the feeder; strips junk prefix (fixed 252 bytes) from each segment.
# segments are written via .part + atomic mv so a partial segment is never
# visible, which lets mpv re-open segments for backward seeking
start_anikoto_fifo() {
    _variant_url="$1"
    _off="${2:-252}"
    _pl="$(anikoto_curl_raw -e "${anikoto_referer}/" "$_variant_url")"
    printf '%s' "$_pl" | grep -q "EXTM3U" || { warn "Failed to fetch HLS playlist for stream"; return 1; }
    anikoto_feed_dir="$(mktemp -d "${TMPDIR:-/tmp}/anikoto-fifo-XXXXXX")" || return 1
    anikoto_feed_fifo=0
    [ "$player_function" = "download" ] && anikoto_feed_fifo=1
    : > "$anikoto_feed_dir/segments.txt"
    _i=0
    printf '%s\n' "$_pl" | while IFS= read -r _line; do
        _s="$(printf '%s\n' "$_line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        case "$_s" in
            \#*) printf '%s\n' "$_line" ;;
            *)
                printf '%s\n' "$anikoto_feed_dir/seg${_i}.ts"
                [ "$anikoto_feed_fifo" = 1 ] && mkfifo "$anikoto_feed_dir/seg${_i}.ts"
                printf '%s\n' "$_s" >> "$anikoto_feed_dir/segments.txt"
                _i=$((_i + 1))
                ;;
        esac
    done > "$anikoto_feed_dir/playlist.m3u8"

    [ ! -s "$anikoto_feed_dir/segments.txt" ] \
        && { warn "No segments in HLS playlist for stream"; rm -rf "$anikoto_feed_dir"; anikoto_feed_dir=""; return 1; }

    anikoto_feed_m3u8="$anikoto_feed_dir/playlist.m3u8"
    _pidfile="$anikoto_feed_dir/feed.pid"
    # daemonize (orphan it) so the shell's `wait` doesn't block on it
    (anikoto_feed_stream "$anikoto_feed_dir" "$_off" &
        printf '%s' "$!" >"$_pidfile")
    sleep 1
    anikoto_feed_pid="$(cat "$_pidfile" 2>/dev/null)"
    if [ -z "$anikoto_feed_pid" ]; then
        warn "Failed to start stream feeder"
        rm -rf "$anikoto_feed_dir"
        anikoto_feed_dir=""
        return 1
    fi

    # playback: buffer the first few segments so mpv starts without stalling
    if [ "$anikoto_feed_fifo" != 1 ]; then
        _n=0
        _waits=0
        while [ "$_waits" -lt 60 ]; do
            _n=0
            _j=0
            while [ "$_j" -lt 5 ]; do
                [ -s "$anikoto_feed_dir/seg$_j.ts" ] && _n=$((_n + 1))
                _j=$((_j + 1))
            done
            [ "$_n" -ge 5 ] && break
            sleep 1
            _waits=$((_waits + 1))
        done
    fi
}

anikoto_feed_cleanup() {
    if [ -n "$anikoto_feed_pid" ]; then
        kill "$anikoto_feed_pid" 2>/dev/null
        wait "$anikoto_feed_pid" 2>/dev/null
        anikoto_feed_pid=""
    fi
    [ -n "$anikoto_feed_dir" ] && rm -rf "$anikoto_feed_dir"
    anikoto_feed_dir=""
    anikoto_feed_m3u8=""
    anikoto_feed_variant=""
    anikoto_feed_fifo=0
}

# gets m3u8 stream URL from the active provider and selects quality
get_episode_url() {
    links=""

    if get_anikoto_m3u8 "$id" "$ep_no"; then
        _m3u8_content="$(anikoto_curl_raw -e "${anikoto_referer}/" "$anikoto_m3u8")"
        if printf '%s' "$_m3u8_content" | grep -q "EXTM3U"; then
            _base="$(printf '%s' "$anikoto_m3u8" | sed 's|[^/]*$||')"
            links="$(printf '%s' "$_m3u8_content" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|; /EXT-X-I-FRAME/d' | sort -nr)"
            # variant URLs may be relative - expand them against the master's base
            links="$(printf '%s' "$links" | awk -v b="$_base" -F'>' 'BEGIN{OFS=">"} $2 !~ /^https?:/ {print $1, b $2} $2 ~ /^https?:/ {print}')"
            [ -n "$links" ] && printf "\033[1;32m%s\033[0m Links Fetched\n" "anikototv.to" 1>&2
        fi
    fi

    select_quality "$quality"
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$episode" ] && die "No valid sources found for episode $ep_no"
    else
        [ -z "$episode" ] && die "Episode $ep_no is not available yet"
    fi
}

time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    query="$(printf "%s\n" "$*" | tr ' ' '+')"
    curl --max-time 5 -s -G "$animeschedule/api/v3/anime" --data "q=${query}" | sed 's|"id"|\n|g' | sed -nE 's|.*,"route":"([^"]*)","premier.*|\1|p' | while read -r anime; do
        data=$(curl --max-time 5 -s "$animeschedule/anime/$anime" | sed '1,/"anime-header-list-buttons-wrapper"/d' | sed -nE 's|.*countdown-time-raw" datetime="([^"]*)".*|Next Raw Release: \1|p;s|.*countdown-time" datetime="([^"]*)".*|Next Sub Release: \1|p;s|.*english-title">([^<]*)<.*|English Title: \1|p;s|.*main-title".*>([^<]*)<.*|Japanese Title: \1|p')
        status="Ongoing"
        color="33"
        printf "%s\n" "$data"
        ! (printf "%s\n" "$data" | grep -q "Next Raw Release:") && status="Finished" && color="32"
        printf "Status:  \033[1;%sm%s\033[0m\n---\n" "$color" "$status"
    done
}

# PLAYING

process_hist_entry() {
    ep_list=$(episodes_list_anikoto "$id")
    latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
    title=$(printf "%s\n" "$title" | sed "s|[0-9][0-9]* episodes|${latest_ep} episodes|")
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}")
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$id" "$title" "$ep_no"
    [ -n "$ep_no" ] || printf "%s\t%s - episode %s (up to date)\n" "$id" "$title" "$latest_ep"
}

update_history() {
    _pos="${1:-0}"
    if grep -qF "	${id}	" "$histfile"; then
        safe_title=$(printf '%s' "$title" | sed 's/[&\|]/\\&/g')
        safe_id=$(printf '%s' "$id" | sed 's/[.[\*^$]/\\&/g')
        sed -E "s|^[^	]+	${safe_id}	[^	]+(	[^	]+)?$|${ep_no}	${safe_id}	${safe_title}	${_pos}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\t%s\n" "$ep_no" "$id" "$title" "$_pos" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

backup_old_hist() {
    backupfile="${histfile}.v4"
    : >"${histfile}.new"
    while IFS="	" read -r _ep _id _title _pos; do
        case "$_id" in
            *-*) printf "%s\t%s\t%s\t%s\n" "$_ep" "$_id" "$_title" "$_pos" >>"${histfile}.new" ;;
            *) printf "%s\t%s\t%s\t%s\n" "$_ep" "$_id" "$_title" "$_pos" >>"$backupfile" ;;
        esac
    done <"$histfile"
    mv "${histfile}.new" "$histfile"
}

get_mpv_position() {
    _socket="/tmp/koto-cli-mpv-$$"
    if [ -S "$_socket" ]; then
        _pos=$(printf '{ "command": ["get_property", "time-pos"] }\n' | socat - UNIX-CONNECT:"$_socket" 2>/dev/null | sed -nE 's|.*"data":([0-9.]+).*|\1|p')
        [ -n "$_pos" ] && printf "%s" "$_pos" && return 0
    fi
    printf "0"
}

resume_episode() {
    _hist_id="$1"
    _pos=$(grep -F "$_hist_id" "$histfile" | cut -f4)
    [ -z "$_pos" ] && return 1
    [ "$_pos" = "0" ] && return 1
    printf "%.0f" "$_pos"
}

download() {
    _dl_refr="${refr_flag#--referrer=}"
    case $1 in
        *m3u8*)
            command -v "yt-dlp" >/dev/null && yt-dlp --referer "$_dl_refr" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4" && return 0
            ffmpeg -extension_picky 0 -referer "$_dl_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4"
            ;;
        *)
            # shellcheck disable=SC2086
            aria2c --referer="$_dl_refr" --enable-rpc=false --check-certificate=false --continue $iSH_DownFix --summary-interval=0 -x 16 -s 16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide
            ;;
    esac
}

android_mpv() {
    dir="/storage/emulated/0/mpv"
    file="$dir/mpv.config.mp4"
    if [ -w "${dir%*/mpv}" ]; then
        [ -d "${dir}" ] || mkdir "${dir}"
        printf "%s" "$3" | sed 's| --|\n|g; s|^--||g' >"$file"
    fi
    am start --user 0 -a android.intent.action.VIEW -d "$1" -n is.xyz.mpv/.MPVActivity -e "title" "$2" >/dev/null 2>&1
    unset dir file
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t koto-cli "${anime_title}${ep_no}"
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -q "$mal_id" -e "$canon_ep_no")"
    [ -z "$episode" ] && get_episode_url

    # wait for the previous player to close before starting a new one
    wait 2>/dev/null

    # resume position
    _resume_pos=""
    if [ "$resume_enabled" = 1 ]; then
        _resume_pos=$(resume_episode "$id")
        [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && warn "Resuming from $_resume_pos seconds..."
    fi

    # mpv socket for position tracking
    _mpv_socket=""
    case "$player_function" in
        mpv*|flatpak_mpv)
            _mpv_socket="/tmp/koto-cli-mpv-$$"
            ;;
    esac

    # shellcheck disable=SC2086
    case "$player_function" in
        debug)
            printf "All links:\n%s\nSelected link:\n" "$links"
            printf "%s\n" "$episode"
            ;;
        mpv*)
            _mpv_args=""
            [ -n "$_mpv_socket" ] && rm -f "$_mpv_socket"
            [ -n "$_mpv_socket" ] && _mpv_args="--input-ipc-server=$_mpv_socket"
            [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && _mpv_args="$_mpv_args --start=$_resume_pos"
            # the local feed is a bunch of plain files, so mpv disables its
            # cache by default; enable it so the buffer bar shows and mpv reads
            # ahead (which also lets it seek into already-downloaded segments)
            # cache-secs caps read-ahead so mpv doesn't try to read past data
            # the feeder hasn't written yet
            if [ -n "$anikoto_feed_m3u8" ]; then
                _mpv_args="$_mpv_args --cache=yes --cache-secs=120 --hr-seek=absolute --demuxer-max-bytes=50MiB --demuxer-max-back-bytes=0"
            fi
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $_mpv_args $skip_flag --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $refr_flag $player_extra_flags >/dev/null 2>&1 &
            else
                $player_function $_mpv_args $skip_flag $refr_flag --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $player_extra_flags
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        android_mpv) "$player_function" "$episode" "${anime_title} Episode ${ep_no}" "--tls-verify=no $refr_flag" $player_extra_flags 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$episode" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *iina*)
            [ -n "$refr_flag" ] && refr_flag="--mpv-${refr_flag#--}"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                nohup $player_function --no-stdin --mpv-tls-verify=no --mpv-force-media-title="${anime_title} Episode ${ep_no}" $refr_flag "$episode" $player_extra_flags >/dev/null 2>&1 &
            else
                nohup $player_function --no-stdin --mpv-tls-verify=no --keep-running --mpv-force-media-title="${anime_title} Episode ${ep_no}" $refr_flag "$episode" $player_extra_flags >/dev/null 2>&1 &
            fi
            ;;
        flatpak_mpv)
            _flatpak_resume=""
            [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && _flatpak_resume="--start=$_resume_pos"
            _flatpak_cache=""
            if [ -n "$anikoto_feed_m3u8" ]; then
                _flatpak_cache="--cache=yes --cache-secs=120 --hr-seek=absolute --demuxer-max-bytes=50MiB --demuxer-max-back-bytes=0"
            fi
            if [ "$no_detach" = 0 ]; then
                nohup flatpak run io.mpv.Mpv --input-ipc-server="$_mpv_socket" $_flatpak_resume $_flatpak_cache --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" $skip_flag "$episode" $refr_flag $player_extra_flags >/dev/null 2>&1 &
            else
                flatpak run io.mpv.Mpv --input-ipc-server="$_mpv_socket" $_flatpak_resume $_flatpak_cache --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" $skip_flag $refr_flag "$episode" $player_extra_flags
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        vlc*) nohup $player_function --http-referrer="${refr_flag#--referrer=}" --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function "$episode" $player_extra_flags -- --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" $refr_flag >/dev/null 2>&1 & ;;
        download) "$player_function" "$episode" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        catt) nohup catt cast "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
        iSH)
            printf "\e]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\e]8;;\a\n" "$episode"
            sleep 5
            ;;
        *) nohup $player_function "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
    esac
    replay="$episode"
    unset episode

    # save playback position
    case "$player_function" in
        mpv*|flatpak_mpv)
            if [ "$menu_program" != "fzf" ]; then
                _final_pos=0
                while kill -0 "$!" 2>/dev/null; do
                    _pos=$(get_mpv_position)
                    [ -n "$_pos" ] && [ "$_pos" != "0" ] && _final_pos=$_pos
                    sleep 1
                done
                update_history "$_final_pos"
            fi
            ;;
        *)
            update_history "0"
            ;;
    esac
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n1) && unset start
    [ -z "$end" ] || [ "$end" = "$start" ] && unset start end
    [ "$end" = "-1" ] && end=$(printf "%s" "$ep_list" | tail -n1)
    line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$line_count" != 1 ] || [ -n "$start" ]; then
        [ -z "$start" ] && start=$(printf "%s\n" "$ep_no" | head -n1)
        [ -z "$end" ] && end=$(printf "%s\n" "$ep_no" | tail -n1)
        range=$(printf "%s\n" "$ep_list" | sed -nE "/^${start}\$/,/^${end}\$/p")
        [ -z "$range" ] && die "Invalid range!"

        # batch download progress
        if [ "$batch_mode" = 1 ]; then
            _total=$(printf "%s\n" "$range" | wc -l | tr -d " ")
            _count=0
        fi

        for i in $range; do
            tput clear
            ep_no=$i
            canon_ep_no="$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/=")"
            if [ "$batch_mode" = 1 ]; then
                _count=$((_count + 1))
                printf "\33[2K\r\033[1;34m[%s/%s] Downloading episode %s...\033[0m\n" "$_count" "$_total" "$ep_no"
                # skip if already downloaded
                _fname="${anime_title} Episode ${ep_no}.mp4"
                if [ -f "$download_dir/$_fname" ]; then
                    printf "\33[2K\r\033[1;33mSkipping episode %s (already exists)\033[0m\n" "$ep_no"
                    continue
                fi
            else
                info "Playing episode $ep_no..."
            fi
            [ "$i" = "$end" ] && unset range
            play_episode
        done
    else
        canon_ep_no="$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/=")"
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

# MAIN

# setup
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0"

curl_exe=$(dep_ch_failover "curl_chrome136,curl_firefox135,curl_ff117,curl") || die "Program curl not found"
mode="${KOTO_CLI_MODE:-sub}"
