no_detach="${KOTO_CLI_NO_DETACH:-0}"
exit_after_play="${KOTO_CLI_EXIT_AFTER_PLAY:-0}"
skip_intro="${KOTO_CLI_SKIP_INTRO:-0}"
menu_program="${KOTO_CLI_MENU:-fzf}"
menu_extra_flags="${KOTO_CLI_MENU_FLAGS:-}"

[ -t 0 ] || { command -v rofi >/dev/null 2>&1 && menu_program=rofi; }
[ -t 0 ] || { command -v dmenu >/dev/null 2>&1 && menu_program=dmenu; }

hist_dir="${KOTO_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/koto-cli}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/koto-hsts"
[ ! -f "$histfile" ] && : >"$histfile"
search="search"
branch="${KOTO_CLI_BRANCH:-main}"
resume_enabled=0
batch_mode=0

while [ $# -gt 0 ]; do
    case "$1" in
        -v | --vlc)
            case "$_platform" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *ish*) player_function="iSH" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -s | --syncplay)
            case "$_os" in
                Darwin*) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
                MINGW* | *Msys)
                    export PATH="$PATH":"/c/Program Files (x86)/Syncplay/"
                    player_function="syncplay.exe"
                    ;;
                *) player_function="syncplay" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -p | --provider)
            [ $# -lt 2 ] && die "missing argument!"
            provider="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -c | --continue) search=history ;;
        --resume) resume_enabled=1 ;;
        --batch)
            [ "$player_function" = "iSH" ] && iSH_DownFix="--async-dns=false"
            player_function=download
            batch_mode=1
            ;;
        -d | --download)
            [ "$player_function" = "iSH" ] && iSH_DownFix="--async-dns=false"
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$_os" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t koto-cli ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        --dub) mode="dub" ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) menu_program=rofi ;;
        --dmenu) menu_program=dmenu ;;
        --skip) skip_intro=1 ;;
        -N | --nextep-countdown) search=nextep ;;
        -U | --update)
            dep_ch "patch"
            [ $# -ge 2 ] && [ "${2#-}" = "$2" ] && branch="$2"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed "s|^ ||;s| |+|g")" ;;
    esac
    shift
done
[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

case "$provider" in
    anikoto) ;;
    *) die "Unknown provider: $provider (supported: anikoto)" ;;
esac

info "Using provider: $provider"

info "Checking dependencies..."
dep_ch "curl"
dep_ch "sed"
dep_ch "grep"
[ "$skip_intro" = 1 ] && dep_ch "ani-skip"
dep_ch "$menu_program"
case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Neither yt-dlp nor ffmpeg found' ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled.\n" ;;
    *iSH*) printf "\33[2K\rChecking of players on iOS is disabled\n" ;;
    mpv|flatpak_mpv) dep_ch "socat" ;;
    *) dep_ch "$player_function" ;;
esac

trap 'cleanup; exit 1' INT HUP TERM
trap 'cleanup' EXIT

# searching
case "$search" in
    history)
        backup_old_hist
        anime_list=$(while read -r ep_no id title _pos; do process_hist_entry; done <"$histfile")
        [ -z "$anime_list" ] && die "No unwatched series in history!"
        [ -z "${index##*[!0-9]*}" ] && id=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: " | cut -f1)
        [ -z "${index##*[!0-9]*}" ] || id=$(printf "%s" "$anime_list" | sed -n "${index}p" | cut -f1)
        [ -z "$id" ] && exit 1
        title=$(printf "%s" "$anime_list" | grep "$id" | cut -f2 | sed 's/ - episode.*//')
        ep_list=$(episodes_list_anikoto "$id")
        ep_no=$(printf "%s" "$anime_list" | grep "$id" | cut -f2 | sed -nE 's/.*- episode (.+)$/\1/p')
        anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        anikoto_desc "$id" || true
        printf "%s" "$anime_list" | grep "$id" | cut -f2 | grep -q "(up to date)" && { time_until_next_ep "$anime_title"; exit 0; }
        ;;
    *)
        if [ "$menu_program" = "fzf" ]; then
            while [ -z "$query" ]; do
                printf "\33[2K\r\033[1;36mSearch anime: \033[0m" && read -r query
            done
        else
            [ -z "$query" ] && query=$(: | menu "Search anime: " "" "$menu_extra_flags")
            [ -z "$query" ] && exit 1
        fi
        # for checking new releases by specifying anime name
        [ "$search" = "nextep" ] && time_until_next_ep "$query" && exit 0

        query=$(printf "%s" "$query" | sed "s| |+|g")

        anime_list=$(search_anikoto "$query")
        [ -z "$anime_list" ] && die "No results found!"
        # check if select-nth index is a valid number, if so skip interactive selection
        [ "$index" -eq "$index" ] 2>/dev/null && result=$(printf "%s" "$anime_list" | sed -n "${index}p")
        [ -z "$index" ] && result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")
        [ -z "$result" ] && die "Invalid/No Anime Selection"
        title="$(printf "%s" "$result" | cut -f2)"
        anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        id="$(printf "%s" "$result" | cut -f1)"
        anikoto_desc "$id" || true
        ep_list=$(episodes_list_anikoto "$id")
        [ -z "$ep_list" ] && die "Could not fetch episodes for \"$title\" - it may be unavailable on anikototv.to, try another result"
        if [ -n "$ep_no" ] && [ "$ep_no" != "-1" ] && ! printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
            _latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
            if [ "$(printf '%s\n%s' "$_latest_ep" "$ep_no" | sort -n | tail -n1)" = "$ep_no" ] && [ "$_latest_ep" != "$ep_no" ]; then
                info "\"$title\" is still airing. Next episode not yet released."
                time_until_next_ep "$anime_title"
                exit 0
            else
                die "Invalid Episode Selection"
            fi
        fi
        [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
        [ -z "$ep_no" ] && die "Invalid/No Episode Selection"
        ;;
esac

# moves the cursor up one line and clears that line
tput cuu1 && tput el
# stores the position of cursor
tput sc

# playback & loop
play
[ "$player_function" = "download" ] && exit 0
[ "$player_function" = "debug" ] && exit 0

# check if other seasons exist (cached from anikoto_desc)
_has_seasons=0
[ "$player_function" != "download" ] && [ "$player_function" != "debug" ] && {
    _season_count="$(printf '%s' "$anikoto_seasons_cached" | grep -c . 2>/dev/null)"
    [ "$_season_count" -gt 1 ] && _has_seasons=1
}

_menu="next
replay
previous
select
change_quality"
[ "$_has_seasons" = 1 ] && _menu="${_menu}
seasons"
_menu="${_menu}
quit"

while cmd=$(printf '%s' "$_menu" | nth "Playing episode $ep_no of $title... "); do
    # save playback position before acting on the menu choice
    if [ "$menu_program" = "fzf" ]; then
        case "$player_function" in
            mpv*|flatpak_mpv) update_history "$(get_mpv_position)" ;;
        esac
    fi
    case "$cmd" in
        next) safe_ep=$(printf '%s' "$ep_no" | sed 's|[.[\*^$/]|\\&|g'); ep_no=$(printf "%s" "$ep_list" | sed -n "/^${safe_ep}$/{n;p;}") 2>/dev/null ;;
        replay) episode="$replay" ;;
        previous) safe_ep=$(printf '%s' "$ep_no" | sed 's|[.[\*^$/]|\\&|g'); ep_no=$(printf "%s" "$ep_list" | sed -n "/^${safe_ep}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag") ;;
        seasons)
            _seasons="$(anikoto_seasons "$anikoto_numeric_id")"
            [ -z "$_seasons" ] && die "No other versions of \"$title\" found"
            new_anime="$(printf '%s' "$_seasons" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")"
            [ -z "$new_anime" ] && die "Invalid/No Anime Selection"
            id="$(printf '%s' "$new_anime" | cut -f1)"
            title="$(printf '%s' "$new_anime" | cut -f2)"
            anime_title="$(printf '%s' "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
            anikoto_desc "$id" || true
            ep_list=$(episodes_list_anikoto "$id")
            [ -z "$ep_list" ] && die "Could not fetch episodes for \"$title\""
            ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
            [ -z "$ep_no" ] && die "Invalid/No Episode Selection"
            ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | menu "Select quality: " "" "$menu_extra_flags" | cut -d">" -f1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            [ -z "$episode" ] && die "No valid sources found for quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

