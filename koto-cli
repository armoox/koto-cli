download_dir="${KOTO_CLI_DOWNLOAD_DIR:-.}"
log_episode="${KOTO_CLI_LOG:-1}"
quality="${KOTO_CLI_QUALITY:-best}"
_platform="$(uname -a | cut -d " " -f 1,3-)"
_os="$(uname -s)"
case "$_platform" in
    *Darwin*) player_function="${KOTO_CLI_PLAYER:-$(where_iina)}" ;;   # mac OS
    *ndroid*) player_function="${KOTO_CLI_PLAYER:-android_mpv}" ;;     # Android OS (termux)
    *MINGW* | *WSL2*) player_function="${KOTO_CLI_PLAYER:-mpv.exe}" ;; # Windows OS
    *ish*) player_function="${KOTO_CLI_PLAYER:-iSH}" ;;                # iOS (iSH)
